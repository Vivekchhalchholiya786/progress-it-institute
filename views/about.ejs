<%- include('partials/header') %>

<!-- Page Header -->
<section class="page-header" style="background: linear-gradient(135deg, var(--primary-dark), var(--primary)); color: white; padding: 4rem 0; text-align: center; margin-top: 80px;">
    <div class="container fade-in">
        <h1 style="font-size: 3rem; margin-bottom: 1rem;">About Us</h1>
        <p style="font-size: 1.2rem; opacity: 0.9; max-width: 600px; margin: 0 auto;">Empowering Futures Through IT Education</p>
    </div>
</section>

<!-- About Section -->
<section style="padding: 4rem 0;">
    <div class="container">
        <div class="grid grid-2 fade-in" style="align-items: center; gap: 4rem;">
            <div>
                <h2 style="font-size: 2.5rem; margin-bottom: 1.5rem; color: var(--secondary);">Welcome to Progress IT Institute</h2>
                <p style="margin-bottom: 1rem; line-height: 1.8; color: var(--text-muted); font-size: 1.1rem;">
                    Welcome to Progress IT Institute, where your future in IT begins. We are a leading institute dedicated to providing high-quality IT training across a wide range of fields. Our mission is to empower individuals with the skills, knowledge, and certifications needed to excel in the rapidly evolving tech industry.
                </p>
                <p style="margin-bottom: 1.5rem; line-height: 1.8; color: var(--text-muted); font-size: 1.1rem;">
                    At Progress IT Institute, we offer a comprehensive selection of IT courses, including all modules of SAP, along with popular and trending technologies like Python, Django, Cloud Computing, AWS, Hadoop, Data Science, Software Testing, Digital Marketing, Salesforce, DevOps, Cybersecurity, Networking, and many more. Whether you are a beginner or an experienced professional, our diverse curriculum is designed to meet your career goals and help you stay ahead in the tech world.
                </p>
                <a href="/courses" class="btn btn-primary" style="margin-top: 1rem;">Explore Our Courses</a>
            </div>
            
            <div style="position: relative;">
                <div style="width: 100%; height: 400px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg);">
                    <img src="/images/pic3.jpg" alt="Our Batch" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                <div style="position: absolute; bottom: -20px; left: -20px; background: white; padding: 1.5rem; border-radius: var(--radius-md); box-shadow: var(--shadow-md);">
                    <h3 style="color: var(--primary); font-size: 2rem; margin: 0;">100%</h3>
                    <p style="color: var(--text-muted); font-weight: 500;">Placement Assistance</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Location Section -->
<section style="background: var(--surface); padding: 4rem 0;">
    <div class="container fade-in">
        <div class="section-title">
            <h2>Our Location</h2>
            <p>Unmatched convenience for students and professionals.</p>
        </div>
        
        <div style="max-width: 800px; margin: 0 auto; text-align: center;">
            <p style="line-height: 1.8; color: var(--text-muted); font-size: 1.1rem; margin-bottom: 2rem;">
                Progress IT Institute is ideally located in Nigdi Pune, offering unmatched convenience for students and professionals alike. Situated near Nigdi Bhakti Shakti, the institute enjoys excellent connectivity with all modes of transport available at your doorstep. The location ensures that commuting is a breeze, significantly reducing travel time. By joining Progress IT Institute, you’ll not only benefit from top-quality education but also enjoy the convenience of a well-connected location, saving you the hassle of long, stressful commutes.
            </p>
            <div style="display: inline-block; padding: 1rem 2rem; border: 2px solid var(--border); border-radius: var(--radius-md); background: white;">
                <i class='bx bx-map' style="font-size: 2rem; color: var(--primary); margin-bottom: 0.5rem;"></i>
                <h4 style="margin-bottom: 0.5rem;">T-10 Inspiria Mall</h4>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Nigdi, Pune, Maharashtra 411044</p>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
