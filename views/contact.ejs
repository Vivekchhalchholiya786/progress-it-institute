<%- include('partials/header') %>

<main style="padding-top: 80px;">
    <!-- Page Header -->
    <div class="page-header">
        <div class="container fade-in">
            <h1>Contact Us</h1>
            <p>We are here to help and answer any question you might have. We look forward to hearing from you.</p>
        </div>
    </div>

    <section>
        <div class="container">
            <div class="grid" style="grid-template-columns: 1fr 1fr;">
                
                <!-- Contact Information -->
                <div class="fade-in">
                    <h2 style="margin-bottom: 2rem;">Get In Touch</h2>
                    <p style="color: var(--text-muted); margin-bottom: 3rem;">Whether you have a question about courses, pricing, or anything else, our team is ready to answer all your questions.</p>
                    
                    <div style="display: flex; flex-direction: column; gap: 2rem;">
                        <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
                            <div style="width: 50px; height: 50px; background: rgba(37,99,235,0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">
                                <i class='bx bx-map'></i>
                            </div>
                            <div>
                                <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Our Location</h3>
                                <p style="color: var(--text-muted);">T-10, 3rd Floor, Inspiria Mall, near Nigdi Bus stop, Pimpri-Chinchwad, Pune, Maharashtra 411044</p>
                            </div>
                        </div>
                        
                        <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
                            <div style="width: 50px; height: 50px; background: rgba(37,99,235,0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">
                                <i class='bx bx-phone'></i>
                            </div>
                            <div>
                                <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Phone Number</h3>
                                <p style="color: var(--text-muted);">9766767389 / 73899 65540</p>
                            </div>
                        </div>
                        
                        <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
                            <div style="width: 50px; height: 50px; background: rgba(37,99,235,0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">
                                <i class='bx bx-envelope'></i>
                            </div>
                            <div>
                                <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Email Address</h3>
                                <p style="color: var(--text-muted);">info@progressitinstitute.com</p>
                            </div>
                        </div>
                        
                        <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
                            <div style="width: 50px; height: 50px; background: rgba(37,99,235,0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">
                                <i class='bx bx-time-five'></i>
                            </div>
                            <div>
                                <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Working Hours</h3>
                                <p style="color: var(--text-muted);">Monday - Sunday: 10:00 AM - 9:00 PM</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Google Maps Embed -->
                <div class="fade-in" style="transition-delay: 0.2s;">
                    <div style="background: var(--surface); padding: 1rem; border-radius: var(--radius-md); box-shadow: var(--shadow-md); height: 100%; border: 1px solid var(--border);">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3780.278500297597!2d73.766113!3d18.651515!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bc2b9e76c8fa205%3A0x1b210131915734!2sInspiria%20Mall!5e0!3m2!1sen!2sin!4v1683234567890!5m2!1sen!2sin" 
                            width="100%" 
                            height="100%" 
                            style="border:0; border-radius: var(--radius-sm); min-height: 400px;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
                
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
