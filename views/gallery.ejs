<%- include('partials/header') %>

<main style="padding-top: 80px;">
    <!-- Page Header -->
    <div class="page-header">
        <div class="container fade-in">
            <h1>Gallery & Placements</h1>
            <p>Take a look at our state-of-the-art facilities and celebrate the success of our students who secured top IT roles.</p>
        </div>
    </div>

    <!-- Gallery Section -->
    <section>
        <div class="container">
            <div class="section-title fade-in">
                <h2>Our Institute Gallery</h2>
                <p>A glimpse into our classrooms, labs, and interactive sessions.</p>
            </div>
            
            <div class="grid grid-3">
                <div class="card fade-in" style="padding: 0; overflow: hidden; height: 350px;">
                    <img src="/images/pic1.jpg" alt="Classroom" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                </div>
                <div class="card fade-in" style="transition-delay: 0.1s; padding: 0; overflow: hidden; height: 350px;">
                    <img src="/images/pic2.jpg" alt="Placement Celebration" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                </div>
                <div class="card fade-in" style="transition-delay: 0.2s; padding: 0; overflow: hidden; height: 350px;">
                    <img src="/images/pic3.jpg" alt="Batch Group Photo" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                </div>
                <div class="card fade-in" style="transition-delay: 0.3s; padding: 0; overflow: hidden; height: 350px;">
                    <img src="/images/pic4.jpg" alt="Placement" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                </div>
                <div class="card fade-in" style="transition-delay: 0.4s; padding: 0; overflow: hidden; height: 350px;">
                    <img src="/images/pic5.jpg" alt="Batch Group Photo" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                </div>
                <div class="card fade-in" style="transition-delay: 0.5s; padding: 0; overflow: hidden; height: 350px; display: flex; align-items: center; justify-content: center; background: white;">
                    <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/progress.it/" data-instgrm-version="14" style="background:#FFF; border:0; margin:0; padding:0; width:100%; height:100%;">
                        <div style="padding:16px; text-align:center;"> 
                            <a href="https://www.instagram.com/progress.it/" style="color:#38bdf8; text-decoration:none; font-weight:bold; font-size:1.2rem;" target="_blank">View More on Instagram @progress.it</a>
                        </div>
                    </blockquote>
                </div>
            </div>
            <script async src="//www.instagram.com/embed.js"></script>
        </div>
    </section>

    <!-- Placement Records -->
    <section style="background: var(--surface);">
        <div class="container">
            <div class="section-title fade-in">
                <h2>Student Placements & Success Stories</h2>
                <p>Our students are placed in top multinational companies around the globe.</p>
            </div>
            
            <div class="grid grid-3">
                <div class="card fade-in" style="text-align: center;">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--primary-light); margin: 0 auto 1rem; overflow: hidden;">
                        <img src="https://ui-avatars.com/api/?name=Shivam+Rathore&background=38bdf8&color=fff" alt="Student" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <h3>Shivam Rathore</h3>
                    <p style="color: var(--primary); font-weight: 600; margin-bottom: 1rem;">Placed as SAP FICO Consultant</p>
                    <p style="color: var(--text-muted); font-style: italic;">"Progress IT is the best SAP Institute in Pune. I have done SAP FICO. The staff is really helpful and they revise each topic one to one."</p>
                </div>
                
                <div class="card fade-in" style="transition-delay: 0.1s; text-align: center;">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--primary-light); margin: 0 auto 1rem; overflow: hidden;">
                        <img src="https://ui-avatars.com/api/?name=Sarang+Katakdeore&background=0284c7&color=fff" alt="Student" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <h3>Sarang Katakdeore</h3>
                    <p style="color: var(--primary); font-weight: 600; margin-bottom: 1rem;">Placed as SAP MM Analyst</p>
                    <p style="color: var(--text-muted); font-style: italic;">"This is the best SAP institute in Nigdi Pune. Sourabh sir's teaching is very nice and friendly. Anytime available for solving queries."</p>
                </div>
                
                <div class="card fade-in" style="transition-delay: 0.2s; text-align: center;">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--primary-light); margin: 0 auto 1rem; overflow: hidden;">
                        <img src="https://ui-avatars.com/api/?name=Rahul+Verma&background=10b981&color=fff" alt="Student">
                    </div>
                    <h3>Rahul Verma</h3>
                    <p style="color: var(--primary); font-weight: 600; margin-bottom: 1rem;">Placed as Full Stack Dev</p>
                    <p style="color: var(--text-muted); font-style: italic;">"The practical approach to coding helped me clear my technical rounds with ease. Highly recommend their web development course."</p>
                </div>
            </div>
            
            <div style="margin-top: 4rem; text-align: center; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 3rem; background: rgba(37,99,235,0.05);" class="fade-in">
                <h3 style="font-size: 1.5rem; margin-bottom: 1.5rem;">Companies Where Our Alumni Work</h3>
                <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: center;">
                    <div class="partner-logo-item"><img src="/images/logos/tcs.svg" alt="TCS"></div>
                    <div class="partner-logo-item"><img src="/images/logos/infosys.svg" alt="Infosys"></div>
                    <div class="partner-logo-item"><img src="/images/logos/wipro.svg" alt="Wipro"></div>
                    <div class="partner-logo-item"><img src="/images/logos/accenture.svg" alt="Accenture"></div>
                    <div class="partner-logo-item"><img src="/images/logos/capgemini.svg" alt="Capgemini"></div>
                    <div class="partner-logo-item"><img src="/images/logos/cognizant.svg" alt="Cognizant"></div>
                </div>
            </div>

            <!-- Google Reviews Section -->
            <div class="google-reviews-widget fade-in" style="margin-top: 5rem;">
                <div class="google-reviews-header">
                    <div class="google-brand">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google Logo" style="width: 45px; height: 45px;">
                        <div>
                            <h3>Progress IT Institute</h3>
                            <p class="google-business-title">SAP training Institute in Pune | AWS | Devops | cyber security | Data science | English spoken</p>
                            <p class="google-business-address"><i class='bx bx-map'></i> T-10, 3rd Floor, Bus stop, near Nigdi, Nigdi Gaothan, Nigdi, Pimpri-Chinchwad, Pune, Maharashtra 411044, India</p>
                        </div>
                    </div>
                    <div class="google-rating-summary">
                        <div class="rating-number">4.9</div>
                        <div class="stars-outer">
                            <div class="stars-inner">
                                <i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i>
                            </div>
                        </div>
                        <p class="reviews-count">Based on 248 Google reviews</p>
                        <span class="verified-badge"><i class='bx bxs-badge-check'></i> Verified Google Business</span>
                    </div>
                </div>

                <div class="google-reviews-grid">
                    <div class="google-review-card">
                        <div class="reviewer-meta">
                            <div class="reviewer-avatar" style="background:#ea4335;">A</div>
                            <div style="flex: 1;">
                                <h4 class="reviewer-name">Aniket Deshpande</h4>
                                <span class="review-date">A week ago</span>
                            </div>
                            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" class="g-logo" style="width:18px;">
                        </div>
                        <div class="review-stars">
                            <i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i>
                        </div>
                        <p class="review-text">"Progress IT Institute is by far the best SAP training institute in Pune! Sourabh Sir's teaching methodology is completely hands-on. He explains all MM & FICO modules from scratch. Excellent doubt solving!"</p>
                    </div>

                    <div class="google-review-card">
                        <div class="reviewer-meta">
                            <div class="reviewer-avatar" style="background:#4285f4;">P</div>
                            <div style="flex: 1;">
                                <h4 class="reviewer-name">Prerna Kulkarni</h4>
                                <span class="review-date">2 weeks ago</span>
                            </div>
                            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" class="g-logo" style="width:18px;">
                        </div>
                        <div class="review-stars">
                            <i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i>
                        </div>
                        <p class="review-text">"The AWS and DevOps course here is amazing. Rahul sir helped me set up complete CI/CD pipelines, Docker, Kubernetes, and Terraform. The lab facility in Inspiria Mall Nigdi is excellent. Got placed in Capgemini!"</p>
                    </div>

                    <div class="google-review-card">
                        <div class="reviewer-meta">
                            <div class="reviewer-avatar" style="background:#34a853;">S</div>
                            <div style="flex: 1;">
                                <h4 class="reviewer-name">Sandip Patil</h4>
                                <span class="review-date">A month ago</span>
                            </div>
                            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" class="g-logo" style="width:18px;">
                        </div>
                        <div class="review-stars">
                            <i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i><i class='bx bxs-star'></i>
                        </div>
                        <p class="review-text">"Really helpful counseling by Pallavi Mam. She guided me through course selection and coupon discounts. They also have an English speaking session which helped me clear the interviews successfully."</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
