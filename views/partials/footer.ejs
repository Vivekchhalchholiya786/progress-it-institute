<!-- Enquiry Popup -->
<div class="popup-overlay" id="enquiryPopup">
    <div class="popup-content">
        <button class="close-btn" onclick="closeEnquiryPopup()"><i class='bx bx-x'></i></button>
        <h2 style="margin-bottom:1.5rem; color:var(--secondary);">Enquire Now</h2>
        <p style="color:var(--text-muted); margin-bottom:2rem;">Fill out the form below and our counselor will get back to you shortly.</p>
        
        <form id="enquiryForm">
            <div class="form-group">
                <label for="name">Full Name *</label>
                <input type="text" id="name" name="name" class="form-control" required placeholder="John Doe">
            </div>
            
            <div class="form-group" style="display:flex; gap:1rem;">
                <div style="flex:1;">
                    <label for="phone">Phone Number *</label>
                    <input type="tel" id="phone" name="phone" class="form-control" required placeholder="+91 XXXXXXXXXX">
                </div>
                <div style="flex:1;">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="john@example.com">
                </div>
            </div>
            
            <div class="form-group">
                <label for="course">Course of Interest</label>
                <select id="course" name="course" class="form-control">
                    <option value="">Select a course</option>
                    <optgroup label="SAP ERP Modules">
                        <option value="SAP FICO">SAP FICO (Financials)</option>
                        <option value="SAP MM">SAP MM (Materials Mgmt)</option>
                        <option value="SAP SD">SAP SD (Sales & Dist)</option>
                        <option value="SAP PP">SAP PP (Prod Planning)</option>
                        <option value="SAP ABAP">SAP ABAP (Programming)</option>
                        <option value="SAP SuccessFactors / HCM">SAP SuccessFactors</option>
                        <option value="SAP BASIS">SAP BASIS (Admin)</option>
                        <option value="SAP HANA">SAP HANA (Database)</option>
                    </optgroup>
                    <optgroup label="Cloud, AI, Data & Business">
                        <option value="Agentic AI">Agentic AI</option>
                        <option value="Advanced Generative AI">Advanced Generative AI</option>
                        <option value="Data Science with AI">Data Science with AI</option>
                        <option value="Data Science">Data Science</option>
                        <option value="AWS DevOps">AWS DevOps</option>
                        <option value="Databricks">Databricks</option>
                        <option value="Azure Cloud">Azure Cloud</option>
                        <option value="Data Analytics">Data Analytics</option>
                        <option value="Financial Analyst">Financial Analyst</option>
                        <option value="PySpark">PySpark</option>
                    </optgroup>
                </select>
            </div>
            
            <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" class="form-control" rows="3" placeholder="Any specific questions?"></textarea>
            </div>
            
            <button type="submit" class="btn btn-primary" style="width:100%;">
                Submit Enquiry <i class='bx bx-send'></i>
            </button>
            <div id="formMessage" style="margin-top:1rem; text-align:center; display:none; font-weight:500;"></div>
        </form>
