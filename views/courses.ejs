<%- include('partials/header') %>

<main style="padding-top: 80px;">
    <!-- Page Header -->
    <div class="page-header">
        <div class="container fade-in">
            <h1>Our Premium Programs</h1>
            <p>Advance your technical capabilities with our certified courses. Choose from our specialized IT portfolios designed by industry experts.</p>
        </div>
    </div>

    <section>
        <div class="container">
            
            <!-- CATEGORY: SAP SPECIALIZATION (FLAGSHIP SINGLE BANNER) -->
            <div style="margin-bottom: 5rem;">
                <h2 style="margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem;" class="fade-in">
                    <i class='bx bx-building-house text-gradient' style="font-size: 2.2rem;"></i> SAP Specialized Modules (Flagship Programs)
                </h2>
                
                <div class="card fade-in" style="
