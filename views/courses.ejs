<!-- Styling for clickable course cards -->
<style>
    /* Clickable area styling */
    .course-card-link {
        display: block;
        color: inherit;
        text-decoration: none;
        margin-bottom: 1.5rem;
    }
    
    .course-card-link:hover .course-card-title {
        color: var(--primary);
    }
    
    .course-card-link:hover .course-card-visual i {
        transform: scale(1.15) rotate(5deg);
    }

    /* Visual header container */
    .course-card-visual {
        height: 140px; 
        border-radius: var(--radius-sm); 
        margin-bottom: 1.5rem; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        color: white; 
        font-size: 3rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.4s ease;
    }
    .course-card-visual i {
        transition: transform 0.4s ease;
    }

    .course-card-title {
        font-size: 1.35rem; 
        color: var(--text-main); 
        margin-bottom: 1rem;
        transition: color 0.3s ease;
    }

    .course-card-desc {
        color: var(--text-muted); 
        font-size: 0.95rem; 
        line-height: 1.6;
    }

    /* Dual button footer styling */
    .card-btn {
        flex: 1;
        padding: 0.65rem 0.8rem !important;
        font-size: 0.85rem !important;
        border: none;
        border-radius: var(--radius-full);
        text-align: center;
        letter-spacing: 0.5px;
    }
    
    .btn-outline.card-btn {
        border: 2px solid var(--primary) !important;
        color: var(--primary);
        background: transparent;
    }
    .btn-outline.card-btn:hover {
        background: var(--gradient-1) !important;
        color: white !important;
        border-color: transparent !important;
    }

    /* SAP submodule dynamic link styling */
    .sap-submodule-link {
        display: flex; 
        align-items: center; 
        gap: 10px; 
        color: inherit;
        padding: 0.5rem 0.8rem;
        border-radius: var(--radius-sm);
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
    }

    .sap-submodule-link:hover {
        color: #ffffff !important;
        background: rgba(139, 92, 246, 0.2);
        border-color: rgba(139, 92, 246, 0.4);
        transform: translateX(5px);
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.2);
    }
    
    .sap-submodule-link i {
        color: #10b981; 
        font-size: 1.4rem;
        transition: transform 0.3s ease;
    }
    
    .sap-submodule-link:hover i {
        transform: scale(1.2);
        color: #34d399;
    }
</style>

