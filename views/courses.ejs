                            <!-- Sub-modules Grid -->
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.2rem; margin-bottom: 1.5rem;">
                                <a href="/courses/sap-fico" class="sap-submodule-link">
                                    <i class='bx bx-check-circle'></i>
                                    <span><strong>SAP FICO</strong> (Finance & Control)</span>
                                </a>
                                <a href="/courses/sap-mm" class="sap-submodule-link">
                                    <i class='bx bx-check-circle'></i>
                                    <span><strong>SAP MM</strong> (Materials Mgmt)</span>
                                </a>
                                <a href="/courses/sap-sd" class="sap-submodule-link">
                                    <i class='bx bx-check-circle'></i>
                                    <span><strong>SAP SD</strong> (Sales & Distribution)</span>
                                </a>
                                <a href="/courses/sap-pp" class="sap-submodule-link">
                                    <i class='bx bx-check-circle'></i>
                                    <span><strong>SAP PP</strong> (Production Planning)</span>
                                </a>
                                <a href="/courses/sap-abap" class="sap-submodule-link">
                                    <i class='bx bx-check-circle'></i>
                                    <span><strong>SAP ABAP</strong> (Advanced Dev)</span>
