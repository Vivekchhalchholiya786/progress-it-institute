                    <!-- Integrated side query box -->
                    <div class="integrated-query-box">
                        <h3>Quick Admissions Inquiry</h3>
                        <p>Have questions about batches, fees, or coupon codes? Send us a quick query!</p>
                        <form id="slideQueryForm" class="slide-query-form">
                            <div class="form-group-row">
                                <input type="text" id="slideName" required placeholder="Full Name *">
                            </div>
                            <div class="form-group-row">
                                <input type="tel" id="slidePhone" required placeholder="Phone Number *">
                            </div>
                            <div class="form-group-row">
                                <select id="slideCourse" required>
                                    <option value="" disabled selected>Course of Interest *</option>
                                    <optgroup label="SAP ERP Modules">
                                        <option value="SAP FICO">SAP FICO (Financials)</option>
                                        <option value="SAP MM">SAP MM (Materials Mgmt)</option>
                                        <option value="SAP SD">SAP SD (Sales & Dist)</option>
                                        <option value="SAP PP">SAP PP (Prod Planning)</option>
                                        <option value="SAP ABAP">SAP ABAP (Programming)</option>
                                        <option value="SAP SuccessFactors / HCM">SAP SuccessFactors</option>
                                        <option value="SAP BASIS">SAP BASIS (Admin)</option>
                                        <option value="SAP HANA">SAP HANA (Database)</option>
                                    </optgroup>
                                    <optgroup label="Advanced Tech & Portfolios">
                                        <option value="Agentic AI">Agentic AI</option>
                                        <option value="Advanced Generative AI">Advanced Generative AI</option>
                                        <option value="Data Science with AI">Data Science with AI</option>
                                        <option value="Data Science">Data Science</option>
                                        <option value="AWS DevOps">AWS DevOps</option>
                                        <option value="Databricks">Databricks</option>
                                        <option value="Azure Cloud">Azure Cloud</option>
                                        <option value="Data Analytics">Data Analytics</option>
                                        <option value="Financial Analyst">Financial Analyst</option>
                                        <option value="PySpark">PySpark</option>
                                    </optgroup>
                                </select>
                            </div>
                            <div class="form-group-row">
                                <textarea id="slideMessage" rows="2" placeholder="Your Message..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary" style="width: 100%;">
                                Send Query <i class='bx bx-paper-plane'></i>
                            </button>
                            <div id="slideFormMsg" class="slide-form-msg"></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Slider Arrows -->
        <button class="slider-btn prev-btn" id="prevSlideBtn" aria-label="Previous Slide"><i class='bx bx-chevron-left'></i></button>
        <button class="slider-btn next-btn" id="nextSlideBtn" aria-label="Next Slide"><i class='bx bx-chevron-right'></i></button>

        <!-- Slider Indicators -->
        <div class="slider-dots-container">
            <span class="slide-dot active" data-slide="0"></span>
            <span class="slide-dot" data-slide="1"></span>
            <span class="slide-dot" data-slide="2"></span>
        </div>
    </section>

