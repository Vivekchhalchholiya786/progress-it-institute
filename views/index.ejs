                                    <circle cx="14" cy="14" r="12" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"/>
                                    <ellipse cx="14" cy="14" rx="6" ry="12" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1"/>
                                    <line x1="2" y1="14" x2="26" y2="14" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
                                    <circle cx="14" cy="14" r="3" fill="#fbbf24"/>
                                </svg>
                                <div>
                                    <p style="font-size: 0.8rem; font-weight: 700; color: white;">Global Certification Vendor Partner</p>
                                    <p style="font-size: 0.65rem; color: rgba(255,255,255,0.7);">Internationally Recognized Programs</p>
