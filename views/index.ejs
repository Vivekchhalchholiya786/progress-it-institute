                                        <path d="M16 36 L24 40 L32 36" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                    <p style="font-size: 0.75rem; font-weight: 700; color: #1e40af;">ISO 9001:2015</p>
                                    <p style="font-size: 0.65rem; color: #475569;">Certified Institute</p>
                                </div>
                                <!-- Govt of India Badge -->
                                <div style="background: linear-gradient(135deg, #fef3c7, #fde68a33); border: 1px solid #fbbf24; border-radius: 12px; padding: 1rem; text-align: center; transition: transform 0.3s ease;">
                                    <svg width="48" height="48" viewBox="0 0 48 48" style="margin: 0 auto 0.5rem;">
                                        <polygon points="24,2 28,16 44,16 31,26 35,40 24,32 13,40 17,26 4,16 20,16" fill="#f59e0b" opacity="0.15" stroke="#f59e0b" stroke-width="1.5"/>
                                        <circle cx="24" cy="21" r="10" fill="none" stroke="#d97706" stroke-width="1.5"/>
                                        <text x="24" y="19" text-anchor="middle" fill="#92400e" font-size="5" font-weight="800" font-family="Outfit">GOVT</text>
                                        <text x="24" y="25" text-anchor="middle" fill="#b45309" font-size="4" font-weight="600" font-family="Outfit">OF INDIA</text>
                                    </svg>
                                    <p style="font-size: 0.75rem; font-weight: 700; color: #92400e;">Govt. of India</p>
                                    <p style="font-size: 0.65rem; color: #475569;">Recognized</p>
                                </div>
                                <!-- MSME Badge -->
                                <div style="background: linear-gradient(135deg, #ecfdf5, #d1fae5); border: 1px solid #6ee7b7; border-radius: 12px; padding: 1rem; text-align: center; transition: transform 0.3s ease;">
                                    <svg width="48" height="48" viewBox="0 0 48 48" style="margin: 0 auto 0.5rem;">
                                        <rect x="6" y="6" width="36" height="36" rx="8" fill="none" stroke="#10b981" stroke-width="2"/>
                                        <rect x="10" y="10" width="28" height="28" rx="5" fill="#10b981" opacity="0.1"/>
                                        <text x="24" y="22" text-anchor="middle" fill="#065f46" font-size="9" font-weight="800" font-family="Outfit">MSME</text>
                                        <text x="24" y="32" text-anchor="middle" fill="#047857" font-size="5" font-weight="600" font-family="Outfit">REGISTERED</text>
                                    </svg>
                                    <p style="font-size: 0.75rem; font-weight: 700; color: #065f46;">MSME Registered</p>
                                    <p style="font-size: 0.65rem; color: #475569;">Organization</p>
                                </div>
                                <!-- NSDC / Skill India Badge -->
                                <div style="background: linear-gradient(135deg, #faf5ff, #ede9fe); border: 1px solid #c4b5fd; border-radius: 12px; padding: 1rem; text-align: center; transition: transform 0.3s ease;">
                                    <svg width="48" height="48" viewBox="0 0 48 48" style="margin: 0 auto 0.5rem;">
                                        <circle cx="24" cy="24" r="20" fill="none" stroke="#7c3aed" stroke-width="2"/>
                                        <path d="M18 28 L24 18 L30 28 Z" fill="#7c3aed" opacity="0.15" stroke="#7c3aed" stroke-width="1.5"/>
                                        <text x="24" y="36" text-anchor="middle" fill="#5b21b6" font-size="5" font-weight="800" font-family="Outfit">NSDC</text>
                                        <circle cx="24" cy="12" r="3" fill="#7c3aed" opacity="0.3"/>
                                    </svg>
                                    <p style="font-size: 0.75rem; font-weight: 700; color: #5b21b6;">NSDC Partner</p>
                                    <p style="font-size: 0.65rem; color: #475569;">Skill India</p>
                                </div>
                            </div>
                            <!-- Global Certification Banner -->
                            <div style="margin-top: 1rem; background: linear-gradient(135deg, #1e40af, #2563eb); border-radius: 10px; padding: 0.8rem 1rem; display: flex; align-items: center; gap: 0.75rem;">
