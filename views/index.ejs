                        </div>
                        <div class="mini-courses-grid">
                            <div class="mini-course-item">
                                <div class="item-icon green"><i class='bx bx-building-house'></i></div>
                                <div>
                                    <h4>SAP ERP Modules</h4>
                                    <p>FICO, MM, SD, PP, ABAP, SuccessFactors, BASIS, HANA</p>
                                </div>
                            </div>
                            <div class="mini-course-item">
                                <div class="item-icon blue"><i class='bx bx-bot'></i></div>
                                <div>
                                    <h4>Advanced AI & GenAI</h4>
                                    <p>Agentic AI, LLM RAG, LangChain, OpenAI</p>
                                </div>
