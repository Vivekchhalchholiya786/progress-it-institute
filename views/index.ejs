<%- include('partials/header') %>

<main>
    <!-- Glowing Background Particles -->
    <div class="hero-glow-particles"></div>

    <!-- Modern Hero Slider Section -->
    <section class="hero-slider-section">
        <div class="slider-container" id="heroSlider">
            <!-- Slide 1: Original Front Page Content + Stunning 3D Rotating Cube -->
            <div class="slide active" id="slide-1">
                <div class="container slide-grid">
                    <div class="hero-content">
                        <h1><span class="text-gradient">Empowering Futures</span> Through IT Education</h1>
                        <p>Welcome to Progress IT Institute in Pune. Advance your career with in-demand certifications in SAP, Python, Cloud Computing, Cyber Security, and more.</p>
                        <div class="hero-cta-btns">
                            <button class="btn btn-primary" onclick="openEnquiryPopup()">Start Your Journey <i class='bx bx-right-arrow-alt'></i></button>
                            <a href="/courses" class="btn btn-outline">Explore Courses <i class='bx bx-compass'></i></a>
                        </div>
                    </div>
                    <div class="hero-3d-visual">
                        <div class="cube-container">
                            <div class="cube">
                                <div class="face front"><i class='bx bxl-react'></i></div>
                                <div class="face back"><i class='bx bxl-python'></i></div>
                                <div class="face right"><i class='bx bxl-aws'></i></div>
                                <div class="face left"><i class='bx bx-data'></i></div>
                                <div class="face top"><i class='bx bx-code-alt'></i></div>
                                <div class="face bottom"><i class='bx bx-cloud'></i></div>
                            </div>
                        </div>
                        <div class="glow-sphere"></div>
                    </div>
                </div>
            </div>

            <!-- Slide 2: Creative Design with Embedded YouTube Videos -->
