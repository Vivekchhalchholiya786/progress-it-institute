            </div>
            
            <div class="google-reviews-widget fade-in">
                <div class="google-reviews-header">
                    <div class="google-brand">
                        <svg width="24" height="24" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                        <div>
                            <div class="google-business-title">Progress IT Institute</div>
                            <div class="google-business-address">Nigdi, Pimpri-Chinchwad, Pune</div>
                        </div>
                    </div>
                    <div class="google-rating-summary">
                        <span class="rating-number">4.9</span>
                        <div>
                            <div class="review-stars">
                                <i class='bx bxs-star' style="color: #f59e0b;"></i>
                                <i class='bx bxs-star' style="color: #f59e0b;"></i>
                                <i class='bx bxs-star' style="color: #f59e0b;"></i>
                                <i class='bx bxs-star' style="color: #f59e0b;"></i>
                                <i class='bx bxs-star-half' style="color: #f59e0b;"></i>
                            </div>
                            <span class="reviews-count"><%= reviews.length || 8 %> reviews</span>
                        </div>
                    </div>
                </div>
                
                <div class="reviews-carousel-wrapper">
                    <div class="google-reviews-grid" style="display: flex; gap: 1.5rem; padding: 0.5rem 0;">
                        <% if (reviews && reviews.length > 0) { %>
                            <% reviews.forEach(function(review) { %>
                            <div class="google-review-card" style="min-width: 300px; max-width: 350px;">
                                <div class="reviewer-meta">
                                    <div class="reviewer-avatar" style="background: <%= ['#4285F4','#34A853','#EA4335','#FBBC05','#7c3aed','#ec4899','#0ea5e9','#14b8a6'][Math.floor(Math.random()*8)] %>;">
                                        <%= review.reviewerName ? review.reviewerName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0,2) : 'U' %>
                                    </div>
                                    <div>
                                        <div class="reviewer-name"><%= review.reviewerName %></div>
                                        <div class="review-date"><%= review.date || 'Recently' %></div>
                                    </div>
                                </div>
                                <div class="review-stars" style="margin: 0.5rem 0;">
                                    <% for (let i = 0; i < (parseInt(review.rating) || 5); i++) { %>
                                        <i class='bx bxs-star' style="color: #f59e0b; font-size: 0.9rem;"></i>
                                    <% } %>
                                    <% for (let i = (parseInt(review.rating) || 5); i < 5; i++) { %>
                                        <i class='bx bx-star' style="color: #d1d5db; font-size: 0.9rem;"></i>
                                    <% } %>
                                </div>
                                <p class="review-text review-text-truncated"><%= review.reviewText %></p>
                                <% if (review.reviewText && review.reviewText.length > 150) { %>
                                    <button class="read-more-btn">Read more</button>
                                <% } %>
                                <% if (review.source) { %>
                                    <div class="verified-badge" style="margin-top: 0.5rem;"><i class='bx bxs-check-circle' style="color: #34A853;"></i> <%= review.source %> Review</div>
                                <% } %>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <p style="color: var(--text-muted); text-align: center; width: 100%; padding: 2rem;">Reviews coming soon!</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>
