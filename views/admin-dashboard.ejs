                                            <form action="/admin/admission/delete" method="POST" style="display:inline;" 
                                                  onsubmit="return confirm('Delete admission for <%= adm.name %>?')">
                                                <input type="hidden" name="id" value="<%= adm.id %>">
                                                <button type="submit" class="btn-delete">
                                                    <i class='bx bx-trash'></i> Delete
                                                </button>
