                                        <td><strong><%= enq.name %></strong></td>
                                        <td><%= enq.phone %></td>
                                        <td><%= enq.email %></td>
                                        <td><%= enq.course %></td>
                                        <td title="<%= enq.message %>"><%= enq.message %></td>
                                        <td><%= new Date(enq.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                        <td>
                                            <form action="/admin/enquiry/delete" method="POST" style="display:inline;" 
                                                  onsubmit="return confirm('Delete enquiry from <%= enq.name %>?')">
                                                <input type="hidden" name="id" value="<%= enq.id %>">
                                                <button type="submit" class="btn-delete">
                                                    <i class='bx bx-trash'></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- ========== ADMISSIONS TAB ========== -->
        <div id="tab-admissions" class="tab-content">
            <h1>Admission Records</h1>

