                                                <span class="fees-label" style="font-weight: 600; font-size: 0.85rem; color: <%= adm.feesPaid === 'true' ? 'var(--green)' : 'var(--red)' %>;">
                                                    <%= adm.feesPaid === 'true' ? 'Paid' : 'Unpaid' %>
