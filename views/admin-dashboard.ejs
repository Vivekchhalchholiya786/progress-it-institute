        </div>

        <!-- ========== CAREERS TAB ========== -->
        <div id="tab-careers" class="tab-content">
            <h1>Careers & Recruitment Panel</h1>

            <!-- Job Openings Sub-Panel -->
            <div class="card">
                <h2><i class='bx bx-plus-circle'></i> Create Job Opening</h2>
                <form class="coupon-form" action="/admin/careers/job/create" method="POST" style="flex-direction: column; align-items: stretch; gap: 15px;">
                    <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                        <div class="form-field" style="flex: 2; min-width: 200px;">
                            <label>Job Title *</label>
                            <input type="text" name="title" placeholder="e.g. SAP FICO Trainer" required>
                        </div>
                        <div class="form-field" style="flex: 1; min-width: 150px;">
                            <label>Location</label>
                            <input type="text" name="location" placeholder="e.g. Nigdi, Pune" value="Nigdi, Pune">
                        </div>
                    </div>
                    <div class="form-field">
                        <label>Description *</label>
                        <input type="text" name="description" placeholder="Brief details about the role..." required>
                    </div>
                    <div class="form-field">
                        <label>Key Requirements / Qualifications *</label>
                        <input type="text" name="requirements" placeholder="e.g. 3+ years experience, MCA/BE, good skills" required>
                    </div>
                    <button type="submit" class="btn-create" style="align-self: flex-start;">
                        <i class='bx bx-plus'></i> Post Job Opening
                    </button>
                </form>

                <h2 style="margin-top: 30px;"><i class='bx bx-list-ul'></i> Active Job Openings (<%= jobs.length %>)</h2>
                <% if (jobs.length === 0) { %>
                    <div class="empty-state">
                        <i class='bx bx-briefcase'></i>
                        <p>No job openings posted yet.</p>
                    </div>
                <% } else { %>
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Title</th>
                                    <th>Location</th>
                                    <th>Requirements</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% jobs.forEach((job, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td><strong><%= job.title %></strong></td>
                                        <td><%= job.location %></td>
                                        <td title="<%= job.requirements %>"><%= job.requirements %></td>
                                        <td>
                                            <form action="/admin/careers/job/delete" method="POST" style="display:inline;" 
                                                  onsubmit="return confirm('Delete job opening: <%= job.title %>?')">
                                                <input type="hidden" name="id" value="<%= job.id %>">
                                                <button type="submit" class="btn-delete">
                                                    <i class='bx bx-trash'></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <!-- Job Applications Evaluator -->
            <div class="card">
                <h2><i class='bx bxs-user-detail'></i> Candidate Applications (<%= applications.length %>)</h2>
                <% if (applications.length === 0) { %>
                    <div class="empty-state">
                        <i class='bx bx-user-voice'></i>
                        <p>No candidate applications received yet.</p>
                    </div>
                <% } else { %>
                    <div class="table-wrapper">
                        <table id="applicationsTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th class="sortable" onclick="sortTable('applicationsTable', 1, 'string')">Candidate <i class='bx bx-sort-alt-2 sort-icon'></i></th>
                                    <th>Contact Info</th>
                                    <th class="sortable" onclick="sortTable('applicationsTable', 3, 'string')">Position <i class='bx bx-sort-alt-2 sort-icon'></i></th>
                                    <th>Exp & Qualifications</th>
                                    <th>Resume Link</th>
                                    <th>Status</th>
                                    <th class="sortable" onclick="sortTable('applicationsTable', 7, 'date')">Date <i class='bx bx-sort-alt-2 sort-icon'></i></th>
                                    <th>Evaluation Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% applications.forEach((app, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td><strong><%= app.name %></strong></td>
                                        <td>
                                            <%= app.phone %><br>
                                            <span style="font-size:0.8rem; color:var(--text-muted);"><%= app.email %></span>
                                        </td>
                                        <td><%= app.jobs ? app.jobs.title : 'Deleted Position' %></td>
                                        <td>
                                            Qual: <%= app.qualification %><br>
                                            Exp: <%= app.experience %>
                                        </td>
                                        <td>
                                            <a href="<%= app.resumeLink %>" target="_blank" class="badge active" style="text-decoration:none; display:inline-flex; align-items:center; gap:3px;">
                                                <i class='bx bx-link-external'></i> Open Link
                                            </a>
                                        </td>
                                        <td>
                                            <% if (app.status === 'Pending') { %>
                                                <span class="badge active" style="background: rgba(245, 158, 11, 0.1); color: #d97706;">Pending</span>
                                            <% } else if (app.status === 'Shortlisted') { %>
                                                <span class="badge active" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">Shortlisted</span>
                                            <% } else { %>
                                                <span class="badge used" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">Rejected</span>
                                            <% } %>
                                        </td>
                                        <td><%= new Date(app.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                        <td>
                                            <!-- Status Evaluator Form -->
                                            <form action="/admin/careers/application/status" method="POST" style="display:inline-block; margin-right:5px;">
                                                <input type="hidden" name="id" value="<%= app.id %>">
                                                <select name="status" onchange="this.form.submit()" style="padding: 5px; border-radius: 6px; font-size: 0.8rem; border: 1px solid #cbd5e1; outline:none; background:white; cursor:pointer;">
                                                    <option value="" disabled selected>Status...</option>
                                                    <option value="Pending">Pending</option>
                                                    <option value="Shortlisted">Shortlist</option>
                                                    <option value="Rejected">Reject</option>
                                                </select>
                                            </form>
                                            <!-- Delete Form -->
                                            <form action="/admin/careers/application/delete" method="POST" style="display:inline-block;" 
                                                  onsubmit="return confirm('Delete applicant record for <%= app.name %>?')">
                                                <input type="hidden" name="id" value="<%= app.id %>">
                                                <button type="submit" class="btn-delete" style="padding: 5px 10px;">
                                                    <i class='bx bx-trash'></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- ========== BLOGS TAB ========== -->
        <div id="tab-blogs" class="tab-content">
            <h1>Blogs Management</h1>

            <!-- Create/Edit Blog Form Card -->
            <div class="card">
                <h2 id="blogFormHeading"><i class='bx bx-plus-circle'></i> Add New Blog Post</h2>
                
                <form id="blogCrudForm" action="/admin/blog/create" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
                    <input type="hidden" name="id" id="blogFormId">
                    
                    <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                        <div class="form-field" style="flex: 2; min-width: 250px;">
                            <label>Blog Title *</label>
                            <input type="text" name="title" id="blogFormTitle" placeholder="e.g. SAP ABAP: Careers & Growth in 2026" required>
                        </div>
                        <div class="form-field" style="flex: 1; min-width: 150px;">
                            <label>Category *</label>
                            <input type="text" name="category" id="blogFormCategory" placeholder="e.g. SAP ERP, Programming" required>
                        </div>
                        <div class="form-field" style="flex: 1; min-width: 120px;">
                            <label>Read Time *</label>
                            <input type="text" name="readTime" id="blogFormReadTime" placeholder="e.g. 6 Min Read" value="5 Min Read" required>
                        </div>
                    </div>

                    <div class="form-field">
                        <label>Card Summary Description *</label>
                        <input type="text" name="summary" id="blogFormSummary" placeholder="Enter a brief, engaging summary to display on the main blog listing page..." required>
                    </div>

                    <div class="form-field">
