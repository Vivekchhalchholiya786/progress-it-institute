                <% if (enquiries.length === 0) { %>
                    <div class="empty-state">
                        <i class='bx bx-message-dots'></i>
                        <p>No enquiries received yet.</p>
                    </div>
                <% } else { %>
                    <div class="table-wrapper">
                        <table id="enquiriesTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th class="sortable" onclick="sortTable('enquiriesTable', 1, 'string')">Name <i class='bx bx-sort-alt-2 sort-icon'></i></th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th class="sortable" onclick="sortTable('enquiriesTable', 4, 'string')">Course <i class='bx bx-sort-alt-2 sort-icon'></i></th>
                                    <th>Message</th>
                                    <th class="sortable" onclick="sortTable('enquiriesTable', 6, 'date')">Date <i class='bx bx-sort-alt-2 sort-icon'></i></th>
