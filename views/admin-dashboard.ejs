                <h2><i class='bx bx-user-check'></i> All Admissions (<%= admissions.length %>)</h2>

                <% if (admissions.length === 0) { %>
                    <div class="empty-state">
                        <i class='bx bx-graduation'></i>
                        <p>No admission records found.</p>
                    </div>
                <% } else { %>
                    <div class="table-wrapper">
                        <table id="admissionsTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Reg ID</th>
                                    <th class="sortable" onclick="sortTable('admissionsTable', 2, 'string')">Name <i class='bx bx-sort-alt-2 sort-icon'></i></th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th class="sortable" onclick="sortTable('admissionsTable', 5, 'string')">Course <i class='bx bx-sort-alt-2 sort-icon'></i></th>
                                    <th>Final Fee</th>
                                    <th>Coupon</th>
                                    <th>Fees Status</th>
                                    <th class="sortable" onclick="sortTable('admissionsTable', 9, 'date')">Date <i class='bx bx-sort-alt-2 sort-icon'></i></th>
                                    <th>Action</th>
                                </tr>
                            </thead>
