                        <button type="button" id="blogFormCancelBtn" onclick="resetBlogForm()" class="btn-delete" style="display: none; height: 42px; padding: 0 20px; background: rgba(100,116,139,0.1); color: #475569;">
                            Cancel Edit
                        </button>
                    </div>
                </form>
            </div>

            <!-- Blogs List Table Card -->
            <div class="card">
                <h2><i class='bx bx-list-ul'></i> All Published Blog Posts (<%= blogs.length %>)</h2>

                <% if (blogs.length === 0) { %>
                    <div class="empty-state">
                        <i class='bx bx-book-open'></i>
                        <p>No blog posts published yet. Create one using the form above!</p>
                    </div>
                <% } else { %>
                    <div class="table-wrapper">
                        <table id="blogsTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Read Time</th>
                                    <th>Date</th>
                                    <th style="width: 160px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% blogs.forEach((blog, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td title="<%= blog.title %>"><strong><%= blog.title %></strong></td>
                                        <td><span class="badge active" style="background: rgba(99,102,241,0.1); color:#6366f1;"><%= blog.category %></span></td>
                                        <td><%= blog.readTime %></td>
                                        <td><%= blog.date %></td>
                                        <td>
                                            <!-- Edit Trigger -->
                                            <button type="button" onclick='populateBlogForEdit(<%= JSON.stringify(blog) %>)' class="btn-create" style="display: inline-flex; padding: 6px 12px; font-size: 0.8rem; background: #e2e8f0; color: #1e293b; margin-right: 5px; box-shadow: none;">
                                                <i class='bx bx-edit-alt'></i> Edit
                                            </button>
                                            <!-- Delete Trigger -->
                                            <form action="/admin/blog/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this blog post?')">
                                                <input type="hidden" name="id" value="<%= blog.id %>">
                                                <button type="submit" class="btn-delete" style="padding: 6px 12px; font-size: 0.8rem;">
                                                    <i class='bx bx-trash'></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- ========== SETTINGS TAB ========== -->
        <div id="tab-settings" class="tab-content">
            <h1>System Settings</h1>

            <div class="card">
                <form action="/admin/settings/save" method="POST" style="max-width: 600px;">
                    <h2 style="margin-bottom: 10px;"><i class='bx bxl-youtube' style="color: #ef4444;"></i> YouTube Video Management</h2>
                    <p style="color: #64748b; font-size: 0.85rem; margin-bottom: 20px; line-height: 1.5;">
                        Set the YouTube video displayed on the Home Page. The video will NOT auto-update — only the URL you enter here will be shown.
                    </p>

                    <div class="form-field" style="margin-bottom: 20px;">
                        <label>YouTube Video URL</label>
                        <input type="url" name="youtubeVideoUrl" placeholder="https://www.youtube.com/watch?v=... or https://youtu.be/..." value="<%= settings.youtubeVideoUrl || '' %>" style="width: 100%; padding: 11px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 0.9rem; color: #1e293b; outline: none;">
                        <small style="color: #64748b; margin-top: 6px; display: block;">Accepts: youtube.com/watch?v=ID, youtu.be/ID, youtube.com/embed/ID</small>
                    </div>
                    <% if (settings.youtubeVideoUrl) { %>
                    <div style="margin-bottom: 30px; padding: 14px; background: #f8fafc; border-radius: 10px; border: 1px solid #e2e8f0;">
                        <p style="font-weight: 600; font-size: 0.9rem; margin-bottom: 6px; color: #1e293b;"><i class='bx bx-check-circle' style="color: #10b981;"></i> Currently Active Video</p>
                        <p style="font-size: 0.85rem; color: #64748b; word-break: break-all;"><%= settings.youtubeVideoUrl %></p>
                    </div>
                    <% } else { %>
                        <div style="margin-bottom: 30px;"></div>
                    <% } %>

                    <hr style="border: 0; border-top: 1px solid #e2e8f0; margin-bottom: 30px;">

                    <h2 style="margin-bottom: 10px;"><i class='bx bx-cog'></i> SMS Gateway Settings</h2>
                    <p style="color: #64748b; font-size: 0.85rem; margin-bottom: 20px; line-height: 1.5;">
                        Enter your Fast2SMS API Authorization key to enable real-time OTP SMS sending to students. If left blank, the system will fallback to log the OTP in the console.
                    </p>

                    <div class="form-field" style="margin-bottom: 20px;">
                        <label>Fast2SMS API Key</label>
                        <input type="text" name="smsApiKey" placeholder="Enter Fast2SMS API Key" value="<%= settings.smsApiKey || '' %>" style="width: 100%; padding: 11px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 0.9rem; color: #1e293b; outline: none;">
                    </div>
                    <button type="submit" class="btn-create" style="margin-top: 10px;">
                        <i class='bx bx-save'></i> Save Settings
                    </button>
                </form>
            </div>
        </div>

        <!-- ========== REVIEWS TAB ========== -->
        <div id="tab-reviews" class="tab-content">
            <h1>Reviews & Testimonials Management</h1>
            
            <div class="card" style="margin-bottom: 24px;">
                <h2 style="margin-bottom: 20px;"><i class='bx bx-plus-circle'></i> Add New Review</h2>
                <form method="POST" action="/admin/review/create">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                        <div class="form-field">
                            <label>Reviewer Name *</label>
                            <input type="text" name="reviewerName" required placeholder="e.g. Amit Sharma">
                        </div>
                        <div class="form-field">
                            <label>Rating (1-5)</label>
                            <select name="rating" style="width: 100%; padding: 11px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 0.9rem; color: #1e293b; outline: none;">
                                <option value="5" selected>5 Stars</option>
                                <option value="4">4 Stars</option>
                                <option value="3">3 Stars</option>
                                <option value="2">2 Stars</option>
                                <option value="1">1 Star</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-field" style="margin-bottom: 16px;">
                        <label>Review Text *</label>
                        <textarea name="reviewText" required rows="3" placeholder="Enter the review text..." style="width: 100%; padding: 11px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 0.9rem; font-family: inherit; outline: none; resize: vertical;"></textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                        <div class="form-field">
                            <label>Source</label>
                            <select name="source" style="width: 100%; padding: 11px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 0.9rem; color: #1e293b; outline: none;">
                                <option value="Google">Google Review</option>
                                <option value="Manual">Manual / Testimonial</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Date</label>
                            <input type="text" name="date" placeholder="e.g. August 2026">
                        </div>
                    </div>
                    <button type="submit" class="btn-create"><i class='bx bx-plus'></i> Add Review</button>
                </form>
            </div>
            
            <div class="card">
                <h2><i class='bx bx-star'></i> Existing Reviews (<%= reviews.length %>)</h2>
                <% if (reviews.length > 0) { %>
                <div class="table-wrapper">
                    <table>
                        <thead><tr><th>Reviewer</th><th>Rating</th><th>Text</th><th>Source</th><th>Date</th><th>Action</th></tr></thead>
                        <tbody>
                        <% reviews.forEach(function(r) { %>
                            <tr>
                                <td><strong><%= r.reviewerName %></strong></td>
                                <td><%= r.rating %> ⭐</td>
                                <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= r.reviewText %></td>
                                <td><span class="badge active" style="background: rgba(99,102,241,0.1); color:#6366f1;"><%= r.source || 'Google' %></span></td>
                                <td><%= r.date || '-' %></td>
                                <td>
                                    <form method="POST" action="/admin/review/delete" style="display:inline;">
                                        <input type="hidden" name="id" value="<%= r.id %>">
                                        <button type="submit" class="btn-delete" onclick="return confirm('Delete this review?')"><i class='bx bx-trash'></i> Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class='bx bx-star'></i>
                    <p>No reviews yet. Add your first review above.</p>
                </div>
                <% } %>
            </div>
        </div>

        <!-- ========== BROCHURES TAB ========== -->
        <div id="tab-brochures" class="tab-content">
            <h1>Course Brochures Management</h1>
            
            <div class="card" style="margin-bottom: 24px;">
                <h2 style="margin-bottom: 10px;"><i class='bx bx-upload'></i> Set Brochure URL</h2>
                <p style="color: #64748b; font-size: 0.85rem; margin-bottom: 20px; line-height: 1.5;">
                    Set a downloadable brochure URL (Google Drive link, PDF URL, etc.) for each course. Students will see a "Download Brochure" button on course pages.
                </p>
                <form method="POST" action="/admin/brochure/save">
                    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 16px; margin-bottom: 20px;">
                        <div class="form-field">
                            <label>Select Course</label>
                            <select name="courseId" required style="width: 100%; padding: 11px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 0.9rem; color: #1e293b; outline: none;">
                                <option value="">-- Select Course --</option>
                                <% Object.keys(coursesData).forEach(function(key) { %>
                                    <option value="<%= key %>"><%= coursesData[key].title %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Brochure URL</label>
                            <input type="url" name="brochureUrl" required placeholder="https://drive.google.com/file/d/... or direct PDF URL" style="width: 100%; padding: 11px 14px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 0.9rem; color: #1e293b; outline: none;">
                        </div>
                    </div>
                    <button type="submit" class="btn-create"><i class='bx bx-save'></i> Save Brochure</button>
                </form>
            </div>
            
            <div class="card">
                <h2><i class='bx bx-file'></i> Course Brochure Status</h2>
                <div class="table-wrapper">
                    <table>
                        <thead><tr><th>Course</th><th>Brochure URL</th><th>Status</th><th>Action</th></tr></thead>
                        <tbody>
                        <% Object.keys(coursesData).forEach(function(key) { %>
                            <% var brochure = brochures.find(function(b) { return b.courseId === key; }); %>
                            <tr>
                                <td><strong><%= coursesData[key].title %></strong></td>
                                <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    <% if (brochure) { %>
                                        <a href="<%= brochure.brochureUrl %>" target="_blank" style="color: #6366f1; text-decoration: none;"><%= brochure.brochureUrl %></a>
                                    <% } else { %>
                                        <span style="color: #94a3b8;">Not set</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (brochure) { %>
                                        <span class="badge active">Active</span>
                                    <% } else { %>
                                        <span class="badge used" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">Missing</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (brochure) { %>
                                    <form method="POST" action="/admin/brochure/delete" style="display:inline;">
                                        <input type="hidden" name="courseId" value="<%= key %>">
                                        <button type="submit" class="btn-delete" onclick="return confirm('Remove brochure for this course?')"><i class='bx bx-trash'></i> Remove</button>
                                    </form>
                                    <% } else { %>
                                        <span style="color: #94a3b8; font-size: 0.8rem;">-</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <script>
        // Tab Switching Logic
        function switchTab(tabName, el) {
            if (window.event) {
                window.event.preventDefault();
            }

            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));

            // Show selected tab
            const targetTabContent = document.getElementById('tab-' + tabName);
            if (targetTabContent) {
                targetTabContent.classList.add('active');
            }

            // Update sidebar active states
            document.querySelectorAll('.sidebar-nav a').forEach(a => a.classList.remove('active'));
            if (el) {
                el.classList.add('active');
            }

            // Close mobile sidebar
            document.querySelector('.admin-sidebar').classList.remove('open');
        }

        // Auto-switch to correct tab if hash is present (e.g. #settings)
        window.addEventListener('DOMContentLoaded', () => {
            const hash = window.location.hash.substring(1);
            if (hash) {
                const targetTab = document.querySelector(`.sidebar-nav a[data-tab="${hash}"]`);
                if (targetTab) {
                    switchTab(hash, targetTab);
                }
            }

            // Admissions Fees Toggle Action
            document.querySelectorAll('.fees-toggle').forEach(checkbox => {
                checkbox.addEventListener('change', async (e) => {
                    const id = e.target.getAttribute('data-id');
                    const isChecked = e.target.checked;
                    const label = e.target.nextElementSibling;
                    
                    try {
                        const response = await fetch('/admin/admission/toggle-fees', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id, feesPaid: isChecked ? 'true' : 'false' })
                        });
                        const result = await response.json();
                        if (result.success) {
                            label.textContent = isChecked ? 'Paid' : 'Unpaid';
                            label.style.color = isChecked ? 'var(--green)' : 'var(--red)';
                        } else {
                            alert(result.message || 'Error updating status.');
                            e.target.checked = !isChecked; // revert
                        }
                    } catch (err) {
                        alert('Server error updating status.');
                        e.target.checked = !isChecked; // revert
                    }
                });
            });
        });

        // Generate a random 10-character coupon code with letters, numbers, and symbols
        function generateRandomCoupon() {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$!*&';
            let result = '';
            for (let i = 0; i < 10; i++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('couponCodeInput').value = result;
        }

        // Draw and download the coupon ticket card as an image
        function downloadCoupon(code, percent) {
            const canvas = document.createElement('canvas');
            canvas.width = 600;
            canvas.height = 300;
            const ctx = canvas.getContext('2d');

            // 1. Draw Background Gradient
            const gradient = ctx.createLinearGradient(0, 0, 600, 300);
            gradient.addColorStop(0, '#1e293b'); // Dark Slate
            gradient.addColorStop(1, '#0f172a');
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, 600, 300);

            // 2. Draw Dashed Border
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
            ctx.lineWidth = 3;
            ctx.setLineDash([8, 8]);
            ctx.strokeRect(15, 15, 570, 270);
            ctx.setLineDash([]); // Reset dash

            // 3. Draw Ticket Punch Circles (visually matches the card shape)
            ctx.fillStyle = '#f0f2f5'; // Dashboard body bg color
            ctx.beginPath();
            ctx.arc(0, 150, 15, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.arc(600, 150, 15, 0, Math.PI * 2);
            ctx.fill();

            // 4. Draw Branding & Title
            ctx.fillStyle = '#6366f1'; // primary purple
            ctx.font = 'bold 13px sans-serif';
            ctx.fillText('PROGRESS IT INSTITUTE', 40, 55);

            ctx.fillStyle = '#94a3b8';
            ctx.font = 'bold 10px sans-serif';
            ctx.fillText('ADMISSION DISCOUNT VOUCHER', 40, 72);

            // 5. Draw Discount
            ctx.fillStyle = '#ffffff';
            ctx.font = '900 58px sans-serif';
            ctx.fillText(percent + '% OFF', 40, 145);

            // 6. Draw Instructions
            ctx.fillStyle = '#64748b';
            ctx.font = '500 11px sans-serif';
            ctx.fillText('Apply code during online registration for instant discount.', 40, 240);
            ctx.fillText('Valid for one-time use only.', 40, 255);

            // 7. Draw Code Box on the right side
            const boxX = 390;
            const boxY = 70;
            const boxW = 170;
            const boxH = 140;

            // Box background
            ctx.fillStyle = 'rgba(99, 102, 241, 0.08)';
            ctx.fillRect(boxX, boxY, boxW, boxH);
            ctx.strokeStyle = 'rgba(99, 102, 241, 0.25)';
            ctx.lineWidth = 1;
            ctx.strokeRect(boxX, boxY, boxW, boxH);

            // Coupon Code label
            ctx.fillStyle = '#94a3b8';
            ctx.font = 'bold 10px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('COUPON CODE', boxX + boxW / 2, boxY + 30);

            // Coupon Code text
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 18px monospace';
            ctx.fillText(code, boxX + boxW / 2, boxY + 75);

            // Coupon Status
            ctx.fillStyle = '#10b981'; // Active Green
            ctx.font = 'bold 10px sans-serif';
            ctx.fillText('● ACTIVE VOUCHER', boxX + boxW / 2, boxY + 115);

            // Trigger the download of PNG
            const dataUrl = canvas.toDataURL('image/png');
            const link = document.createElement('a');
            link.download = `Coupon_${code}_${percent}pct.png`;
            link.href = dataUrl;
            link.click();
        }

        // Generic client-side HTML table sorter
        function sortTable(tableId, colIndex, dataType) {
            const table = document.getElementById(tableId);
            if (!table) return;
            const tbody = table.querySelector('tbody');
            if (!tbody) return;
            const rows = Array.from(tbody.querySelectorAll('tr'));
            if (rows.length === 0) return;

            // Determine current sorting direction
            const header = table.querySelectorAll('thead th')[colIndex];
            const isAsc = !header.classList.contains('sort-asc');
            
            // Reset sorting classes on all headers in this table
            table.querySelectorAll('thead th').forEach(th => {
                th.classList.remove('sort-asc', 'sort-desc');
                const icon = th.querySelector('.sort-icon');
                if (icon) {
                    icon.className = 'bx bx-sort-alt-2 sort-icon';
                }
            });

            // Set sorting class on active header
            header.classList.add(isAsc ? 'sort-asc' : 'sort-desc');
            const currentIcon = header.querySelector('.sort-icon');
            if (currentIcon) {
                currentIcon.className = isAsc ? 'bx bx-chevron-up sort-icon' : 'bx bx-chevron-down sort-icon';
            }

            // Sort rows
            rows.sort((rowA, rowB) => {
                const cellA = rowA.cells[colIndex].innerText.trim();
                const cellB = rowB.cells[colIndex].innerText.trim();

                if (dataType === 'date') {
                    const dateA = Date.parse(cellA) || 0;
                    const dateB = Date.parse(cellB) || 0;
                    return isAsc ? dateA - dateB : dateB - dateA;
                }

                // Default string comparison
                return isAsc 
                    ? cellA.localeCompare(cellB, undefined, { numeric: true, sensitivity: 'base' })
                    : cellB.localeCompare(cellA, undefined, { numeric: true, sensitivity: 'base' });
            });

            // Re-render rows
            rows.forEach(row => tbody.appendChild(row));
            
            // Maintain row indexing
            rows.forEach((row, i) => {
                if (row.cells[0]) {
                    row.cells[0].innerText = i + 1;
                }
            });
        }

        // Copy coupon code to clipboard
        function copyCoupon(code, btn) {
            navigator.clipboard.writeText(code).then(() => {
                const originalHTML = btn.innerHTML;
                btn.innerHTML = "<i class='bx bx-check'></i>";
                btn.style.background = "#10b981"; // success green
                btn.style.borderColor = "#10b981";
                setTimeout(() => {
                    btn.innerHTML = originalHTML;
                    btn.style.background = "rgba(255,255,255,0.18)";
                    btn.style.borderColor = "rgba(255,255,255,0.3)";
                }, 2000);
            }).catch(err => {
                console.error("Failed to copy coupon code:", err);
            });
        }

        // Share coupon details
        function shareCoupon(code, discount) {
            const shareText = `Use coupon code "${code}" to get an instant ${discount}% discount on professional IT training programs at Progress IT Institute Pune! Register here: ${window.location.origin}/admission`;
            
            if (navigator.share) {
                navigator.share({
                    title: 'Progress IT Institute Discount Offer',
                    text: shareText,
                    url: window.location.origin + '/admission'
                })
                .then(() => console.log('Shared coupon successfully.'))
                .catch((error) => console.log('Error sharing:', error));
            } else {
                navigator.clipboard.writeText(shareText).then(() => {
                    alert('Coupon details and link copied to clipboard! Paste it to share with others.');
                }).catch(err => {
                    // Fallback to WhatsApp
                    const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`;
                    window.open(whatsappUrl, '_blank');
                });
            }
        }

        // Populate Blog Form for editing
        function populateBlogForEdit(blog) {
            document.getElementById('blogFormHeading').innerHTML = "<i class='bx bx-edit-alt'></i> Edit Blog Post";
            document.getElementById('blogCrudForm').action = "/admin/blog/update";
            
            document.getElementById('blogFormId').value = blog.id;
            document.getElementById('blogFormTitle').value = blog.title;
            document.getElementById('blogFormCategory').value = blog.category;
            document.getElementById('blogFormReadTime').value = blog.readTime;
            document.getElementById('blogFormSummary').value = blog.summary;
            document.getElementById('blogFormContent').value = blog.content;
            
            document.getElementById('blogFormSubmitBtn').innerHTML = "<i class='bx bx-save'></i> Update Blog Post";
            document.getElementById('blogFormCancelBtn').style.display = "block";
            
            document.getElementById('blogFormHeading').scrollIntoView({ behavior: 'smooth' });
        }

        // Reset Blog Form
        function resetBlogForm() {
            document.getElementById('blogFormHeading').innerHTML = "<i class='bx bx-plus-circle'></i> Add New Blog Post";
            document.getElementById('blogCrudForm').action = "/admin/blog/create";
            
            document.getElementById('blogFormId').value = "";
            document.getElementById('blogFormTitle').value = "";
            document.getElementById('blogFormCategory').value = "";
            document.getElementById('blogFormReadTime').value = "5 Min Read";
            document.getElementById('blogFormSummary').value = "";
            document.getElementById('blogFormContent').value = "";
            
            document.getElementById('blogFormSubmitBtn').innerHTML = "<i class='bx bx-plus'></i> Create Blog Post";
            document.getElementById('blogFormCancelBtn').style.display = "none";
        }
    </script>
</body>
</html>
